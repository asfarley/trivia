upstream puma_trivia {
  server unix:///home/deploy/apps/trivia/shared/tmp/sockets/puma.sock fail_timeout=0;
}

server {
  listen 80;
  server_name {{ domain }};

  root /home/deploy/apps/trivia/current/public;
  access_log /var/log/nginx/trivia_access.log;
  error_log  /var/log/nginx/trivia_error.log info;

  # Serve precompiled assets directly with long-lived cache headers.
  # Propshaft digests filenames, so cache-busting is handled automatically.
  location ^~ /assets/ {
    gzip_static on;
    expires max;
    add_header Cache-Control public;
    add_header Last-Modified "";
    add_header ETag "";
    break;
  }

  # Serve static files from public/ directly; fall back to Puma.
  try_files $uri/index.html $uri @puma;

  location @puma {
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header Host              $http_host;
    proxy_redirect   off;
    proxy_pass       http://puma_trivia;
  }

  error_page 500 502 503 504 /500.html;
  client_max_body_size 10M;
  keepalive_timeout 10;
}
